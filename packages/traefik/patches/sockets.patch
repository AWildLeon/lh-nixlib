+
+// unixTransport rewrites the "unix+http" scheme back to "http" before delegating
+// to an http.Transport that dials the Unix socket.
+type unixTransport struct {
+	http.Transport
+}
+
+func (t *unixTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req.URL.Scheme = req.URL.Scheme[len("unix+"):]
+	return t.Transport.RoundTrip(req)
+}
+
+// unixH2CTransport rewrites the "unix+h2c" scheme to "http" before delegating to
+// an http2.Transport that dials the Unix socket with prior-knowledge H2C.
+type unixH2CTransport struct {
+	*http2.Transport
+}
+
+func (t *unixH2CTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req.URL.Scheme = "http"
+	return t.Transport.RoundTrip(req)
+}
+
+// registerUnixProtocols wires up "unix+http" and "unix+h2c" schemes so that
+// backends addressed via a Unix socket path are dialed over "unix".
+func registerUnixProtocols(transport *http.Transport) {
+	dialer := &net.Dialer{
+		Timeout:   30 * time.Second,
+		KeepAlive: 30 * time.Second,
+	}
+
+	// Unix socket support for HTTP/1.
+	transport.RegisterProtocol("unix+http", &unixTransport{
+		Transport: http.Transport{
+			MaxIdleConnsPerHost:   transport.MaxIdleConnsPerHost,
+			IdleConnTimeout:       90 * time.Second,
+			ExpectContinueTimeout: 1 * time.Second,
+			DialContext: func(ctx context.Context, netw, addr string) (net.Conn, error) {
+				host, _, err := net.SplitHostPort(addr)
+				if err != nil {
+					return nil, err
+				}
+				return dialer.DialContext(ctx, "unix", host)
+			},
+		},
+	})
+
+	// Unix socket support for HTTP/2 (H2C).
+	transport.RegisterProtocol("unix+h2c", &unixH2CTransport{
+		Transport: &http2.Transport{
+			DialTLS: func(netw, addr string, cfg *tls.Config) (net.Conn, error) {
+				host, _, err := net.SplitHostPort(addr)
+				if err != nil {
+					return nil, err
+				}
+				return net.Dial("unix", host)
+			},
+			AllowHTTP: true,
+		},
+	})
+}
